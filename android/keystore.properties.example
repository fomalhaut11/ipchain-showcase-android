# Copy to android/keystore.properties and replace every placeholder locally.
# UTF-8 without BOM; use forward slashes in the absolute keystore path.
storeFile=C:/path/to/existing-ipchain-upload-key.jks
storePassword=REPLACE_WITH_LOCAL_PASSWORD
keyAlias=REPLACE_WITH_EXISTING_KEY_ALIAS
keyPassword=REPLACE_WITH_LOCAL_PASSWORD
